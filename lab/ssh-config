# Posture lab hosts on the host-only network 192.168.57.0/24. Use from the repo root:
#   uv run posture collect linux --ssh posture-ubuntu --ssh-config lab/ssh-config
# The key is lab-only, generated by `lab/lab.sh up` into lab/keys/ (git-ignored).

Host posture-ubuntu
    HostName 192.168.57.11

Host posture-rocky
    HostName 192.168.57.12

Host posture-*
    User posture
    IdentityFile lab/keys/posture_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile lab/keys/known_hosts
    StrictHostKeyChecking accept-new
