# Posture lab: posture-ubuntu and posture-rocky (posture-dc joins in milestone 7).
#
# - Run vagrant only from this folder and only against these VMs (CLAUDE.md, hard rule 3);
#   lab.sh does that for you.
# - Host-only network 192.168.57.0/24, never bridged. The NAT adapter Vagrant adds is only
#   for `vagrant ssh` and package downloads.
# - No synced folder: the deliberately weak VMs get no write path into the host.
# - Every shell provisioner runs guard_lab.sh first (prepended below), so a profile can't
#   run on a machine that isn't a Posture lab VM.

LAB_NET = "192.168.57"
BOX_VERSION = "202510.26.0"
MACHINES = {
  "posture-ubuntu" => { box: "bento/ubuntu-24.04", ip: "#{LAB_NET}.11" },
  "posture-rocky" => { box: "bento/rockylinux-9", ip: "#{LAB_NET}.12" },
}.freeze

GUARD = File.read(File.join(__dir__, "guard_lab.sh"))

def guarded(script)
  GUARD + "\n" + File.read(File.join(__dir__, script))
end

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true

  MACHINES.each do |name, machine|
    config.vm.define name do |node|
      node.vm.box = machine[:box]
      node.vm.box_version = BOX_VERSION
      node.vm.hostname = name
      node.vm.network "private_network", ip: machine[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name = name
        vb.memory = 1024
        vb.cpus = 2
        vb.linked_clone = true
      end

      # First `vagrant up` only: audit account, its sudoers file, the lab marker.
      node.vm.provision "posture-key", type: "file",
        source: "keys/posture_ed25519.pub", destination: "/tmp/posture_ed25519.pub"
      node.vm.provision "posture-sudoers", type: "file",
        source: "../deploy/sudoers.posture", destination: "/tmp/sudoers.posture"
      node.vm.provision "base", type: "shell", inline: guarded("profiles/linux/base.sh"),
        env: { "POSTURE_LAB_BASE" => "1" }

      # Only on request, on top of the `base` snapshot: lab.sh weak | lab.sh hardened.
      node.vm.provision "weak", type: "shell", run: "never",
        inline: guarded("profiles/linux/weak.sh")
      node.vm.provision "hardened", type: "shell", run: "never",
        inline: guarded("profiles/linux/hardened.sh")
    end
  end
end
