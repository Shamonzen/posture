# Lab-only credentials for the Vagrant VMs (copy to .env). Never reuse these anywhere real.
# The DC enforces the default domain policy when they are set: 14+ characters with upper case,
# lower case and digits (the hardened profile raises the minimum to 14).
LAB_DOMAIN_ADMIN_PASSWORD=change-me-lab-only
LAB_WEAK_USER_PASSWORD=change-me-lab-only
POSTURE_AUDIT_PASSWORD=change-me-lab-only
